node_modules/
dist/
.wrangler/
.dev.vars
.env
*.log
coverage/
# Медиа и секреты никогда не коммитятся
assets/backgrounds/*
assets/music/*
!assets/backgrounds/.gitkeep
!assets/music/.gitkeep
seeds/private/

# Локальный сервис (local/): кэш Piper/голосов и временные файлы рендера
local/.cache/
local/.tmp/
local/.npm-cache/
**/.cache/
**/.tmp/

# Реальные секреты (заполненный файл для `wrangler secret bulk`) — не коммитить
secrets.json
local/secrets.json
