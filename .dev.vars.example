# Скопируйте в .dev.vars (локально) или задайте через `wrangler secret put`.
# НЕ коммитить настоящий .dev.vars!

TELEGRAM_EDITOR_BOT_TOKEN="bot-editor-token"
TELEGRAM_CHANNEL_BOT_TOKEN="bot-publisher-token"
TG_CHANNEL_RU="-1001234567890"
TG_CHANNEL_EN="-1000987654321"
ADMIN_IDS="123456789"
ADMIN_API_KEY="change-me-strong-random"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
YOUTUBE_OAUTH_TOKEN_RU=""
YOUTUBE_OAUTH_TOKEN_EN=""
COOKIE_ENCRYPTION_KEY=""
# Рендер Shorts и прокси крутятся локально на ПК (см. local/), не в Cloudflare-контейнерах.
# Worker дёргает локальный сервис по туннелю (cloudflared/ngrok):
VIDEO_RENDERER_URL="https://xyz.trycloudflare.com"
PROXY_GATEWAY_URL="https://xyz.trycloudflare.com"
# R2 S3-ключи: нужны локальному рендереру (local/.env) для чтения/записи в R2.
# Можно задать здесь (тогда Worker передаст их в теле /render) либо напрямую в local/.env.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
