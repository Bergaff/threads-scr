{
  "name": "threads-digest",
  "version": "0.1.0",
  "description": "Threads Digest — поиск популярных тредов и контент для Telegram и YouTube (Cloudflare Workers)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create threads-digest",
    "db:migrate:local": "wrangler d1 execute threads-digest --local --file=src/db/migrations/0001_init.sql",
    "db:migrate": "wrangler d1 execute threads-digest --file=src/db/migrations/0001_init.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.166.0"
  },
  "engines": {
    "node": ">=18"
  }
}
