# Копировать в .env и заполнить. Используется local/server.js для доступа к R2.
# (Можно не заполнять, если Worker передаёт r2-ключи в теле запроса /render.)

# Порт локального сервиса
PORT=8080

# R2 S3-ключи (Cloudflare Dashboard → R2 → Manage R2 API Tokens)
R2_ACCOUNT_ID=
R2_BUCKET=threads-digest-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
